+#pragma once
+#include "BootFormat.hpp"
+#include <nxui/core/Texture.hpp>
+#include <chrono>
+#include <array>
+#include <string_view>
+#include <future>
+#include <memory>
+#include <string>
+struct Mix_Chunk;
+namespace cards {
+class BootClip {
+public:
+    ~BootClip();
+    void open(const std::string& path);
+    bool update(nxui::GpuDevice& gpu,nxui::Renderer& renderer,bool audioReady,bool sound,int volume);
+    void draw(nxui::Renderer& renderer);
+    void stop();
+    std::string_view error() const { return m_error.data(); }
+private:
+    using Data=boot360::Stream;
+    std::array<char,128> m_error{};
+    void fail(const char* message);
+    struct Frame { unsigned index=0; std::vector<std::uint8_t> pixels; };
+    using Clock=std::chrono::steady_clock;
+    std::future<std::shared_ptr<Data>> m_loading;
+    std::future<Frame> m_decoding;
+    std::shared_ptr<Data> m_data;
+    Frame m_ready;
+    std::unique_ptr<nxui::Texture> m_texture;
+    Mix_Chunk* m_sound=nullptr;
+    Clock::time_point m_opened{},m_started{};
+    bool m_active=false,m_playing=false,m_haveReady=false;
+    unsigned m_shown=0;
+    void queue(unsigned frame);
+};
+} // namespace cards
diff --git a/projects/cards/src/BootFormat.hpp b/projects/cards/src/BootFormat.hpp
new file mode 100644
index 0000000..713b448
--- /dev/null
+++ b/projects/cards/src/BootFormat.hpp
@@ -0,0 +1,75 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+#include <fstream>
+#include <string>
+namespace cards::boot360 {
+struct SkipGate {
+    bool armed=false;
+    bool consume(bool held,bool down) {
+        if (!held) armed=true;
+        return armed && down;
+    }
+};
+struct Bank {
+    std::uint32_t width=0,height=0,num=0,den=0,count=0,durationUs=0,audioSize=0,audioOffset=0;
+    std::vector<std::uint32_t> offsets;
+    unsigned frameAt(double seconds) const {
+        return static_cast<unsigned>(std::clamp(std::floor(seconds*num/den),0.,double(count-1)));
+    }
+    double duration() const { return durationUs/1000000.; }
+};
+inline Bank parsePrefix(const std::vector<std::uint8_t>& bytes,std::uint64_t fileSize) {
+    const char magic[8]={'N','X','B','O','O','T','1','\0'};
+    if (bytes.size()<40 || fileSize>96u*1024u*1024u || !std::equal(magic,magic+8,bytes.begin()))
+        throw std::runtime_error("Invalid startup bank");
+    auto u32=[&](size_t p) { return std::uint32_t(bytes.at(p)) | std::uint32_t(bytes.at(p+1))<<8 |
+        std::uint32_t(bytes.at(p+2))<<16 | std::uint32_t(bytes.at(p+3))<<24; };
+    Bank b; b.width=u32(8);b.height=u32(12);b.num=u32(16);b.den=u32(20);b.count=u32(24);
+    b.durationUs=u32(28);b.audioSize=u32(32);
+    if (b.width!=1280 || b.height!=720 || !b.den || !b.num || b.num>120000 || b.den>10000 ||
+        double(b.num)/b.den>60.01 || b.count<1 || b.count>1200 || b.audioSize>4u*1024u*1024u ||
+        b.durationUs<1 || b.durationUs>20000000 || std::abs(b.duration()-double(b.count)*b.den/b.num)>0.1)
+        throw std::runtime_error("Unsupported startup bank");
+    b.audioOffset=40+(b.count+1)*4;
+    if (std::uint64_t(b.audioOffset)+b.audioSize>=fileSize ||
+        std::uint64_t(b.audioOffset)+b.audioSize>bytes.size() || u32(36)!=b.audioOffset+b.audioSize)
+        throw std::runtime_error("Invalid startup table");
+    for (unsigned i=0;i<=b.count;++i) b.offsets.push_back(u32(40+i*4));
+    if (b.offsets.front()!=b.audioOffset+b.audioSize || b.offsets.back()!=fileSize)
+        throw std::runtime_error("Invalid startup bounds");
+    for (unsigned i=0;i<b.count;++i)
+        if (b.offsets[i+1]<=b.offsets[i] || b.offsets[i+1]-b.offsets[i]>8u*1024u*1024u)
+            throw std::runtime_error("Invalid startup frame");
+    return b;
+}
+inline Bank parse(const std::vector<std::uint8_t>& bytes) { return parsePrefix(bytes,bytes.size()); }
+// Only the table and PCM audio stay resident. One encoded frame is read per job.
+struct Stream {
+    std::ifstream file;
+    std::vector<std::uint8_t> bytes;
+    Bank bank;
+    explicit Stream(const std::string& path):file(path,std::ios::binary|std::ios::ate) {
+        const auto size=file.tellg();
+        if (!file || size<40 || size>96*1024*1024) throw std::runtime_error("Startup clip is missing or incomplete");
+        bytes.resize(40);file.seekg(0);
+        if (!file.read(reinterpret_cast<char*>(bytes.data()),40)) throw std::runtime_error("Startup header is incomplete");
+        const std::uint32_t prefix=std::uint32_t(bytes[36])|std::uint32_t(bytes[37])<<8|
+            std::uint32_t(bytes[38])<<16|std::uint32_t(bytes[39])<<24;
+        if (prefix<40 || prefix>5u*1024u*1024u || prefix>=size) throw std::runtime_error("Invalid startup header size");
+        bytes.resize(prefix);
+        if (!file.read(reinterpret_cast<char*>(bytes.data()+40),prefix-40)) throw std::runtime_error("Startup audio is incomplete");
+        bank=parsePrefix(bytes,static_cast<std::uint64_t>(size));
+    }
+    std::vector<std::uint8_t> frame(unsigned index) {
+        if (index>=bank.count) throw std::runtime_error("Invalid startup frame index");
+        std::vector<std::uint8_t> encoded(bank.offsets[index+1]-bank.offsets[index]);
+        file.clear();file.seekg(bank.offsets[index]);
+        if (!file.read(reinterpret_cast<char*>(encoded.data()),encoded.size())) throw std::runtime_error("Could not read startup frame");
+        return encoded;
+    }
+};
+} // namespace cards::boot360
diff --git a/projects/cards/src/Dashboard360.hpp b/projects/cards/src/Dashboard360.hpp
new file mode 100644
index 0000000..4c5e392
--- /dev/null
+++ b/projects/cards/src/Dashboard360.hpp
@@ -0,0 +1,48 @@
+#pragma once
+#include <array>
+#include "NxeLayout.hpp"
+#include <cmath>
+#include <limits>
+
+// Logical 1280x720 coordinates, shared by drawing, touch and D-pad navigation.
+namespace cards::dash360 {
+struct Tile {
+    float x, y, w, h;
+    bool contains(float px, float py) const {
+        return px >= x && px < x + w && py >= y && py < y + h;
+    }
+};
+inline constexpr std::array<Tile, 9> home = {{
+    {228,184,174,130}, {228,318,174,130}, {228,452,174,130},
+    {406,184,462,264}, {872,184,178,64}, {872,252,178,196},
+    {406,452,229,130}, {639,452,229,130}, {872,452,178,130}
+}};
+inline constexpr std::array<const char*, 8> tabs = {
+    "bing", "home", "social", "games", "tv & movies", "music", "apps", "settings"
+};
+inline constexpr std::array<float, 8> tabX = {154,254,374,494,668,862,980,1090};
+inline Tile grid(int index) {
+    return {228.f + (index % 5) * 166.f, 184.f + (index / 5) * 202.f, 162.f, 198.f};
+}
+inline Tile tile(int index, bool isHome) { return isHome ? home.at(index) : grid(index); }
+// Prefer a tile whose edge overlaps the current tile on the perpendicular
+// axis. This makes the large hero panel behave naturally beside three rows.
+inline int neighbor(int from, int count, bool isHome, int dx, int dy) {
+    const auto a = tile(from, isHome);
+    float best = std::numeric_limits<float>::max();
+    int result = from;
+    for (int i = 0; i < count; ++i) {
+        if (i == from) continue;
+        const auto b = tile(i, isHome);
+        const float cx = b.x + b.w/2 - a.x - a.w/2;
+        const float cy = b.y + b.h/2 - a.y - a.h/2;
+        if ((dx && cx * dx <= 1) || (dy && cy * dy <= 1)) continue;
+        const bool overlap = dx ? b.y < a.y+a.h && a.y < b.y+b.h
+                                : b.x < a.x+a.w && a.x < b.x+b.w;
+        const float score = (overlap ? 0.f : 10000.f) + (dx ? std::abs(cx) + std::abs(cy)*2 : std::abs(cy) + std::abs(cx)*2);
+        if (score < best) { best = score; result = i; }
+    }
+    return result;
+}
+inline int wrapTab(int tab) { return (tab % 8 + 8) % 8; }
+} // namespace cards::dash360
diff --git a/projects/cards/src/Dashboard360.inc b/projects/cards/src/Dashboard360.inc
new file mode 100644
index 0000000..171ce28
--- /dev/null
+++ b/projects/cards/src/Dashboard360.inc
@@ -0,0 +1,362 @@
+// Included inside namespace cards, after CardsActivity's drawing helpers.
+bool CardsActivity::dashLibrary() const {
+    return m_dashTab == 3 || m_dashTab == 4 || m_dashTab == 6;
+}
+
+int CardsActivity::dashCount() const {
+    if (m_dashTab == 1) return 8;
+    if (dashLibrary()) {
+        return static_cast<int>(m_pages[m_page].size());
+    }
+    if (m_dashTab == 0) return 2;
+    if (m_dashTab == 2) return 4;
+    if (m_dashTab == 5) return 3;
+    return 10;
+}
+
+void CardsActivity::dashBeginTab(int tab) {
+    const int next = dash360::wrapTab(tab);
+    if (next == m_dashTab) return;
+    m_dashPrevTab = m_dashTab;
+    m_dashPrevTile = m_dashTile;
+    m_dashPrevCard = m_dashCard;
+    m_dashPrevPage = m_page;
+    // Preserve shoulder-button direction when wrapping between the end tabs.
+    m_dashDir = tab < 0 ? -1 : tab >= 8 ? 1 : next < m_dashTab ? -1 : 1;
+    m_dashTab = next;
+    m_dashIn = m_settings.motion ? 0.f : 1.f;
+}
+
+float CardsActivity::dashSlide() const {
+    return m_settings.motion ? m_dashDir * 490.f * (1.f - nxe::ease(m_dashIn)) : 0.f;
+}
+
+void CardsActivity::dashTab(int tab) {
+    dashBeginTab(tab);
+    m_dashTile = 0;
+    m_zone = Zone::Cards;
+    const int target = m_dashTab == 6 ? kHomebrew : m_dashTab == 4 ? kMedia : kGames;
+    // Dashboard tabs own page selection, including a page hidden in CardsNX.
+    if (m_page != target) {
+        m_page = target;
+        sel() = std::clamp(sel(), 0, std::max(0, static_cast<int>(games().size()) - 1));
+        m_scroll = static_cast<float>(sel());
+        m_pageIn = 1.f;
+        requeueArt();
+        wantArt();
+    }
+    if (dashLibrary()) m_dashTile = sel();
+    m_dashCard = static_cast<float>(m_dashTile);
+    m_audio.play("navigation");
+}
+
+void CardsActivity::dashSettings(const std::string& section) {
+    openSettings();
+    for (int i = 0; i < static_cast<int>(m_sheet.size()); ++i)
+        if (m_sheet[i].name == section) { m_sheetSec = i; m_sheetRow = 0; break; }
+}
+
+void CardsActivity::dashSearch() {
+    askText("Search your library", "Find an installed game or homebrew app", "", 64, [this](const std::string& query) {
+        if (query.empty()) return;
+        auto lower = [](std::string s) {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return std::tolower(c); });
+            return s;
+        };
+        const auto q = lower(query);
+        std::vector<MenuItem> rows;
+        for (int page : {static_cast<int>(kGames), static_cast<int>(kHomebrew), static_cast<int>(kMedia)})
+            for (const auto& g : m_pages[page])
+                if (lower(g.name).find(q) != std::string::npos)
+                    rows.push_back(action(g.name, [this, g, page]() {
+                        dashTab(page == kHomebrew ? 6 : page == kMedia ? 4 : 3);
+                        selectById(g.id);
+                        m_dashTile = sel();
+                    }));
+        if (rows.empty()) { say("No matching games or apps."); return; }
+        openMenu("Search results", std::move(rows));
+    });
+}
+
+void CardsActivity::dashActivate() {
+    m_audio.play("activation");
+    if (dashLibrary()) { if (current()) play(); return; }
+    if (m_dashTab == 0) {
+        if (m_dashTile == 0) dashSearch(); else openBrowser();
+    } else if (m_dashTab == 1) {
+        switch (m_dashTile) {
+            case 0: if (current()) play(); else dashTab(3); break;
+            case 1: openUsers(); break;
+            case 2: dashTab(3); break;
+            case 3: dashTab(4); break;
+            case 4: openMusic(); break;
+            case 5: openGallery(); break;
+            case 6: dashTab(6); break;
+            case 7: dashTab(7); break;
+        }
+    } else if (m_dashTab == 2) {
+        switch (m_dashTile) {
+            case 0:
+#ifdef SWITCHU_MENU
+                openSocial();
+#else
+                { std::string error; openSystem("friends", m_user, error); if (!error.empty()) say(error); }
+#endif
+                break;
+            case 1: openUsers(); break;
+            case 2: openDiscord(); break;
+            case 3: openNotifications(); break;
+        }
+    } else if (m_dashTab == 5) {
+        if (m_dashTile == 0) openMusic();
+        else if (m_dashTile == 1) dashSettings("Sound");
+        else dashTab(4);
+    } else {
+        static const char* sections[] = {"Console", "Look", "Sound", "Internet", "Bluetooth", "Storage", "Home", "Notifications", "About"};
+        if (m_dashTile == 9) openPower();
+        else dashSettings(sections[m_dashTile]);
+    }
+    // Page-picker actions can change the CardsNX page behind this shell.
+}
+
+void CardsActivity::dashMove(int delta) {
+    const int next = nxe::nextCard(m_dashTile,delta,dashCount());
+    if (next == m_dashTile) return;
+    m_dashTile = next;
+    if (dashLibrary()) select(next);
+    if (!m_settings.motion) m_dashCard = static_cast<float>(next);
+    m_audio.play("navigation");
+}
+
+bool CardsActivity::dashInput(float dt) {
+    if (m_moving) return false;
+    auto& in = app().input();
+    using B = nxui::Button;
+    const B directions[][3] = {{B::DLeft,B::LStickL,B::RStickL}, {B::DRight,B::LStickR,B::RStickR},
+                              {B::DUp,B::LStickU,B::RStickU}, {B::DDown,B::LStickD,B::RStickD}};
+    bool held=false, down=false;
+    int direction=-1;
+    for (int i=0;i<4;++i) for (auto button:directions[i]) {
+        if (in.isDown(button)) { down=true; direction=i; }
+        if (in.isHeld(button)) { held=true; if (direction<0) direction=i; }
+    }
+    if (down) m_dashRepeat=0.30f;
+    else if (held && (m_dashRepeat-=dt)<=0.f) { down=true; m_dashRepeat=0.13f; }
+    if (m_dashGuide) {
+        if (m_guideClosing) return true;
+        if (in.isDown(B::B)) { guideBack();return true; }
+        if (in.isDown(B::Y)) { closeGuide(false);dashTab(1);return true; }
+        if (in.isDown(B::X)) { closeGuide(false);openUsers();return true; }
+        if (in.isDown(B::Plus)) { closeGuide(true);return true; }
+        if (in.isDown(B::L)) guideTab(-1);
+        if (in.isDown(B::R)) guideTab(1);
+        if (down) {
+            if (direction<2) guideTab(direction==0?-1:1);
+            else {
+                m_dashGuideRow=nxe::nextCard(m_dashGuideRow,direction==2?-1:1,guideRows().size());
+                m_guideNote.clear();m_audio.play("navigation");
+            }
+        }
+        if (in.isDown(B::A)) dashGuideActivate();
+        return true;
+    }
+    if (in.isDown(B::Y)) { openGuide();return true; }
+    if (in.isDown(B::ZL)) dashTab(m_dashTab-1);
+    if (in.isDown(B::ZR)) dashTab(m_dashTab+1);
+    if (in.isDown(B::L)) dashMove(-1);
+    if (in.isDown(B::R)) dashMove(1);
+    if (down) {
+        if (direction<2) dashMove(direction==0?-1:1);
+        else dashTab(m_dashTab+(direction==2?-1:1));
+    }
+    if (in.isDown(B::Minus)) openNotifications();
+    if (in.isDown(B::X)) askClose();
+    if (in.isDown(B::Plus) && current() && (dashLibrary() || (m_dashTab==1 && m_dashTile==0))) { openOptions(); return true; }
+    if (in.isDown(B::B)) { dashTab(1); return true; }
+    if (in.isDown(B::A)) dashActivate();
+    return true;
+}
+
+bool CardsActivity::dashTouch() {
+    if (m_pickOpen || m_spQrOpen || m_sheetOpen || m_notifOpen || m_quickOpen || m_powerOpen || m_dotsOpen
+        || m_musicOpen || m_optOpen || !m_menu.empty() || m_moving) return handleTouch();
+    auto& in=app().input();
+    if (!in.touchUp()) return in.isTouching();
+    const float x=in.touchX(), y=in.touchY();
+    if (m_dashGuide) {
+        if (m_guideClosing) return true;
+        const float gy=y-(1.f-nxe::ease(m_guideIn))*18.f;
+        auto body=guide360::blade(m_guideTab,m_guideTab);
+        const float horizontal=(m_guidePos-m_guideTab)*38.f;body.x+=horizontal;
+        const int tab=body.contains(x,gy)?-1:guide360::hitBlade(x,gy,m_guideTab);
+        if (tab>=0) { guideTab(tab-m_guideTab);return true; }
+        if (gy>=146 && gy<194 && x>=body.x+249 && x<body.x+297) {
+            closeGuide(false);openUsers();return true;
+        }
+        const int row=guide360::hitRow(x-horizontal,gy,m_guideTab,guideRows().size());
+        if (row>=0) { m_dashGuideRow=row;dashGuideActivate();return true; }
+        if (gy>=523 && gy<557 && x>=body.x && x<body.x+body.w) {
+            const float local=x-body.x;
+            if (local<108) dashGuideActivate();
+            else if(local<204) guideBack();
+            else if(local<340) { closeGuide(false);openUsers(); }
+            else { closeGuide(false);dashTab(1); }
+            return true;
+        }
+        if (x<286 || x>986 || gy<146 || gy>560) closeGuide(true);
+        return true;
+    }
+    if (y<85 && x>1050) { openUsers(); return true; }
+    if (x<290 && y<265) {
+        for (int i=0;i<8;++i) {
+            const float cy=218.f+(i-m_dashTab)*35.f;
+            if (cy>=50 && y>=cy-16 && y<cy+16) { dashTab(i); break; }
+        }
+        return true;
+    }
+    // Hit-test in front-to-back order, matching the visible trapezoids.
+    if (m_dashIn>=0.95f) {
+        const int front=std::clamp(static_cast<int>(std::round(m_dashCard)),0,std::max(0,dashCount()-1));
+        for (int distance=0;distance<7;++distance) for (int side:{1,-1}) {
+            if (distance==0 && side<0) continue;
+            const int i=front+distance*side;
+            if (i<0 || i>=dashCount()) continue;
+            if (nxe::panel(i-m_dashCard).contains(x,y)) {
+                if (i==m_dashTile) dashActivate();
+                else dashMove(i-m_dashTile);
+                return true;
+            }
+        }
+    }
+    if (y>640 && x<200) dashActivate();
+    else if (y>640 && x>=240 && x<360) openGuide();
+    return true;
+}
